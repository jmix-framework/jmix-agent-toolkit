{
  "$schema": "./studio-meta-data.schema.json",
  "install-flow": {
    "steps": [
      {
        "id": "skills",
        "title": "Skills",
        "message": "🛠️ Install Jmix <code>skills</code> into the selected skills folders, in the project or the user home. <br>⏭️ Click <i>Skip</i> to opt out.",
        "inputs": [
          {
            "id": "skillsScope",
            "label": "Installation scope",
            "type": "options",
            "choices": [
              {
                "value": "local",
                "label": "Local (project)",
                "default": true
              },
              {
                "value": "global",
                "label": "Global (user home)"
              }
            ]
          },
          {
            "id": "skillsConventions",
            "label": "📁 Skills folders",
            "type": "options",
            "multi": true,
            "choices": [
              {
                "value": "agents",
                "label": ".agents (Codex, OpenCode, etc)",
                "default": true
              },
              {
                "value": "claude",
                "label": ".claude",
                "default": true
              }
            ]
          }
        ],
        "command": {
          "windows": "& ([scriptblock]::Create((iwr -useb https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.ps1).Content)) skills -ContentRef \"${guidelinesBranch}\" -Conventions \"${skillsConventions}\" -Scope \"${skillsScope}\"",
          "macos": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- skills --content-ref \"${guidelinesBranch}\" --conventions \"${skillsConventions}\" --scope \"${skillsScope}\"",
          "linux": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- skills --content-ref \"${guidelinesBranch}\" --conventions \"${skillsConventions}\" --scope \"${skillsScope}\""
        }
      },
      {
        "id": "guidelines",
        "title": "Guidelines",
        "message": "📘 Add a few lines to the selected guidelines files that point the agents at the Jmix skills. <br>✍️ Your own instructions are kept — the lines are merged in. A guidelines file installed by an older version of this toolkit is replaced instead. Changed user or legacy files are backed up. If <code>CLAUDE.md</code> imports <code>@AGENTS.md</code>, it is left untouched after <code>AGENTS.md</code> is updated. <br>⏭️ Click <i>Skip</i> to leave the project as is; the Jmix skills are then installed but nothing routes the agents to them.",
        "inputs": [
          {
            "id": "guidelinesConventions",
            "label": "📄 Guidelines files",
            "type": "options",
            "multi": true,
            "choices": [
              {
                "value": "agents",
                "label": "AGENTS.md (Codex, OpenCode, etc)",
                "default": true
              },
              {
                "value": "claude",
                "label": "CLAUDE.md",
                "default": true
              }
            ]
          }
        ],
        "command": {
          "windows": "& ([scriptblock]::Create((iwr -useb https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.ps1).Content)) agents-md -ContentRef \"${guidelinesBranch}\" -Conventions \"${guidelinesConventions}\"",
          "macos": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- agents-md --content-ref \"${guidelinesBranch}\" --conventions \"${guidelinesConventions}\"",
          "linux": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- agents-md --content-ref \"${guidelinesBranch}\" --conventions \"${guidelinesConventions}\""
        }
      },
      {
        "id": "mcp",
        "title": "MCP servers",
        "message": "🔌 Connect the agents to MCP servers:<br>🧩 <b>JetBrains</b>: enable the MCP server in IntelliJ IDEA (<i>Settings | Tools | MCP Server</i>).<br>📚 <b>Context7</b>: get a key on <a href=\"https://context7.com\" target=\"_blank\">context7.com</a>. With <i>Local</i>, it is saved in the project files: keep them out of Git.<br>🎭 <b>Playwright</b>: needs Node.js 20+.<br>⏭️ Click <i>Skip</i> to opt out.",
        "inputs": [
          {
            "id": "mcpServers",
            "label": "🔌 Servers",
            "type": "options",
            "multi": true,
            "choices": [
              {
                "value": "jetbrains",
                "label": "JetBrains",
                "default": true
              },
              {
                "value": "context7",
                "label": "Context7",
                "default": true
              },
              {
                "value": "playwright",
                "label": "Playwright",
                "default": true
              }
            ]
          },
          {
            "id": "mcpAgents",
            "label": "🤖 Agents",
            "type": "options",
            "multi": true,
            "choices": [
              {
                "value": "claude",
                "label": "Claude Code",
                "default": true
              },
              {
                "value": "codex",
                "label": "Codex",
                "default": true
              },
              {
                "value": "opencode",
                "label": "OpenCode",
                "default": true
              },
              {
                "value": "junie",
                "label": "Junie",
                "default": true
              }
            ]
          },
          {
            "id": "mcpScope",
            "label": "Registration scope",
            "type": "options",
            "choices": [
              {
                "value": "local",
                "label": "Local (project files)",
                "default": true
              },
              {
                "value": "global",
                "label": "Global (user config)"
              }
            ]
          },
          {
            "id": "context7Key",
            "label": "🔑 Context7 API key",
            "type": "userInput",
            "regex": "^(skip|[A-Za-z0-9._-]{8,})$",
            "errorMessage": "Enter a Context7 API key (at least 8 characters: letters, digits, '.', '_' or '-'), or keep skip.",
            "placeholder": "ctx7sk-...",
            "default": "skip"
          }
        ],
        "command": {
          "windows": "& ([scriptblock]::Create((iwr -useb https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.ps1).Content)) mcp -ContentRef \"${guidelinesBranch}\" -Servers \"${mcpServers}\" -Agents \"${mcpAgents}\" -Scope \"${mcpScope}\" -Context7Key \"${context7Key}\"",
          "macos": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- mcp --content-ref \"${guidelinesBranch}\" --servers \"${mcpServers}\" --agents \"${mcpAgents}\" --scope \"${mcpScope}\" --context7-key \"${context7Key}\"",
          "linux": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- mcp --content-ref \"${guidelinesBranch}\" --servers \"${mcpServers}\" --agents \"${mcpAgents}\" --scope \"${mcpScope}\" --context7-key \"${context7Key}\""
        }
      }
    ]
  }
}

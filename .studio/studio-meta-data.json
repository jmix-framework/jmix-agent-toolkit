{
  "$schema": "./studio-meta-data.schema.json",
  "install-flow": {
    "steps": [
      {
        "id": "skills",
        "title": "Skills",
        "message": "🛠️ Install Jmix <code>skills</code> for the selected agents in the preferred scope (local/global). <br>⏭️ Click <i>Skip</i> to opt out.",
        "inputs": [
          {
            "id": "skillsScope",
            "label": "Installation scope",
            "type": "options",
            "choices": [
              {
                "value": "local",
                "label": "Local (project)",
                "default": true
              },
              {
                "value": "global",
                "label": "Global (user home)"
              }
            ]
          },
          {
            "id": "skillsAgents",
            "label": "🤖 Agents",
            "type": "options",
            "multi": true,
            "choices": [
              {
                "value": "claude",
                "label": "Claude Code",
                "default": true
              },
              {
                "value": "codex",
                "label": "Codex",
                "default": true
              },
              {
                "value": "opencode",
                "label": "OpenCode",
                "default": true
              },
              {
                "value": "junie",
                "label": "Junie",
                "default": true
              }
            ]
          }
        ],
        "command": {
          "windows": "& ([scriptblock]::Create((iwr -useb https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.ps1).Content)) skills -ContentRef \"${guidelinesBranch}\" -Agents \"${skillsAgents}\" -Scope \"${skillsScope}\"",
          "macos": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- skills --content-ref \"${guidelinesBranch}\" --agents \"${skillsAgents}\" --scope \"${skillsScope}\"",
          "linux": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- skills --content-ref \"${guidelinesBranch}\" --agents \"${skillsAgents}\" --scope \"${skillsScope}\""
        }
      },
      {
        "id": "guidelines",
        "title": "Guidelines",
        "message": "📘 Add a few lines to <code>CLAUDE.md</code> / <code>AGENTS.md</code> that point the agent at the Jmix skills (Junie reads <code>AGENTS.md</code>). <br>✍️ Your own instructions are kept — the lines are merged in. A guidelines file installed by an older version of this toolkit is replaced instead. Changed user or legacy files are backed up. If <code>CLAUDE.md</code> imports <code>@AGENTS.md</code>, it is left untouched after <code>AGENTS.md</code> is updated. <br>⏭️ Click <i>Skip</i> to leave the project as is; the Jmix skills are then installed but nothing routes the agent to them.",
        "inputs": [
          {
            "id": "guidelinesAgents",
            "label": "🤖 Agents",
            "type": "options",
            "multi": true,
            "choices": [
              {
                "value": "claude",
                "label": "Claude Code",
                "default": true
              },
              {
                "value": "codex",
                "label": "Codex",
                "default": true
              },
              {
                "value": "opencode",
                "label": "OpenCode",
                "default": true
              },
              {
                "value": "junie",
                "label": "Junie",
                "default": true
              }
            ]
          }
        ],
        "command": {
          "windows": "& ([scriptblock]::Create((iwr -useb https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.ps1).Content)) agents-md -ContentRef \"${guidelinesBranch}\" -Agents \"${guidelinesAgents}\"",
          "macos": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- agents-md --content-ref \"${guidelinesBranch}\" --agents \"${guidelinesAgents}\"",
          "linux": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- agents-md --content-ref \"${guidelinesBranch}\" --agents \"${guidelinesAgents}\""
        }
      },
      {
        "id": "jetbrainsMcp",
        "title": "JetBrains MCP",
        "message": "🔌 Register the <code>JetBrains MCP</code> server with the selected agents. <br>📁 <i>Local</i> writes the project files (<code>.mcp.json</code>, <code>.codex/config.toml</code>, <code>opencode.json</code>); <i>Global</i> writes the user config. Claude Desktop has only a user config. <br>⚙️ Enable the server in <i>Settings | Tools | MCP Server</i> before you continue: the installer asks it which endpoint to use. <br>⏭️ Click <i>Skip</i> to opt out.",
        "inputs": [
          {
            "id": "jetbrainsMcpScope",
            "label": "Registration scope",
            "type": "options",
            "choices": [
              {
                "value": "local",
                "label": "Local (project files)",
                "default": true
              },
              {
                "value": "global",
                "label": "Global (user config)"
              }
            ]
          },
          {
            "id": "jetbrainsMcpAgents",
            "label": "🤖 Agents",
            "type": "options",
            "multi": true,
            "choices": [
              {
                "value": "claude",
                "label": "Claude Code",
                "default": true
              },
              {
                "value": "codex",
                "label": "Codex",
                "default": true
              },
              {
                "value": "opencode",
                "label": "OpenCode",
                "default": true
              },
              {
                "value": "claude-desktop",
                "label": "Claude Desktop"
              }
            ]
          }
        ],
        "command": {
          "windows": "& ([scriptblock]::Create((iwr -useb https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.ps1).Content)) mcp-jetbrains -ContentRef \"${guidelinesBranch}\" -Agents \"${jetbrainsMcpAgents}\" -Scope \"${jetbrainsMcpScope}\"",
          "macos": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- mcp-jetbrains --content-ref \"${guidelinesBranch}\" --agents \"${jetbrainsMcpAgents}\" --scope \"${jetbrainsMcpScope}\"",
          "linux": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- mcp-jetbrains --content-ref \"${guidelinesBranch}\" --agents \"${jetbrainsMcpAgents}\" --scope \"${jetbrainsMcpScope}\""
        }
      },
      {
        "id": "context7",
        "title": "Context7 MCP",
        "message": "🔌 Register the <code>Context7 MCP</code> server with the selected agents. <br>👤 It is always registered in the user config, so the key never lands in project files. <br>🌐 You can get key on <a href=\"https://context7.com\" target=\"_blank\">context7.com</a>. Your key is sent to the installer and never stored by Studio. <br>⏭️ Click <i>Skip</i> to opt out.",
        "inputs": [
          {
            "id": "context7Agents",
            "label": "🤖 Agents",
            "type": "options",
            "multi": true,
            "choices": [
              {
                "value": "claude",
                "label": "Claude Code",
                "default": true
              },
              {
                "value": "codex",
                "label": "Codex",
                "default": true
              },
              {
                "value": "opencode",
                "label": "OpenCode",
                "default": true
              },
              {
                "value": "junie",
                "label": "Junie",
                "default": true
              },
              {
                "value": "claude-desktop",
                "label": "Claude Desktop"
              }
            ]
          },
          {
            "id": "context7Key",
            "label": "🔑 API key",
            "type": "userInput",
            "regex": "^[A-Za-z0-9._-]{8,}$",
            "errorMessage": "Context7 API key must be at least 8 characters: letters, digits, '.', '_' or '-'.",
            "placeholder": "ctx7_..."
          }
        ],
        "command": {
          "windows": "& ([scriptblock]::Create((iwr -useb https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.ps1).Content)) mcp-context7 -ContentRef \"${guidelinesBranch}\" -Agents \"${context7Agents}\" -Context7Key \"${context7Key}\"",
          "macos": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- mcp-context7 --content-ref \"${guidelinesBranch}\" --agents \"${context7Agents}\" --context7-key \"${context7Key}\"",
          "linux": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- mcp-context7 --content-ref \"${guidelinesBranch}\" --agents \"${context7Agents}\" --context7-key \"${context7Key}\""
        }
      },
      {
        "id": "playwright",
        "title": "Playwright",
        "message": "🔌 Register the <code>Playwright MCP</code> server (browser automation) with the selected agents. <br>📁 <i>Local</i> writes the project files, <i>Global</i> the user config. <br>📦 The server starts through <b>npx</b>: Node.js 20+ must be installed. <br>⏭️ Click <i>Skip</i> to opt out.",
        "inputs": [
          {
            "id": "playwrightScope",
            "label": "Registration scope",
            "type": "options",
            "choices": [
              {
                "value": "local",
                "label": "Local (project files)",
                "default": true
              },
              {
                "value": "global",
                "label": "Global (user config)"
              }
            ]
          },
          {
            "id": "playwrightAgents",
            "label": "🤖 Agents",
            "type": "options",
            "multi": true,
            "choices": [
              {
                "value": "claude",
                "label": "Claude Code",
                "default": true
              },
              {
                "value": "codex",
                "label": "Codex",
                "default": true
              },
              {
                "value": "opencode",
                "label": "OpenCode",
                "default": true
              },
              {
                "value": "junie",
                "label": "Junie",
                "default": true
              },
              {
                "value": "claude-desktop",
                "label": "Claude Desktop"
              }
            ]
          }
        ],
        "command": {
          "windows": "& ([scriptblock]::Create((iwr -useb https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.ps1).Content)) playwright -ContentRef \"${guidelinesBranch}\" -Agents \"${playwrightAgents}\" -Scope \"${playwrightScope}\"",
          "macos": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- playwright --content-ref \"${guidelinesBranch}\" --agents \"${playwrightAgents}\" --scope \"${playwrightScope}\"",
          "linux": "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/jmix-framework/jmix-agent-toolkit/${guidelinesBranch}/install.sh | bash -s -- playwright --content-ref \"${guidelinesBranch}\" --agents \"${playwrightAgents}\" --scope \"${playwrightScope}\""
        }
      }
    ]
  }
}
